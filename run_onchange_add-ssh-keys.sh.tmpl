#!/bin/bash

# ssh_config_mm" hash: {{ include  "dot_private/private_dot_ssh/private_config.d/mm" | sha256sum }}
# ssh_config" hash: {{ include  "private_dot_ssh/private_config" | sha256sum }}

{{ if eq .chezmoi.os "darwin" -}}

# Load ssh keys into keychain
ssh-add --apple-use-keychain $(find ~/.private/.ssh/keys -type f | grep -E '.*_ed25519$|.*_rsa$')

{{ else if eq .chezmoi.os "linux" -}}

# No Keychain on Linux: load the keys into the user-scoped agent instead. The keys
# are passphrase-protected, so this prompts once per key that isn't loaded yet.
export SSH_AUTH_SOCK="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/ssh-agent.socket"
systemctl --user enable --now ssh-agent.service

if [ -d ~/.private/.ssh/keys ]; then
  loaded_fingerprints="$(ssh-add -l 2>/dev/null || true)"
  find ~/.private/.ssh/keys -type f \( -name '*_ed25519' -o -name '*_rsa' \) -print0 |
    while IFS= read -r -d '' key; do
      fingerprint="$(ssh-keygen -lf "$key" 2>/dev/null | awk '{print $2}')"
      if [ -n "$fingerprint" ] && echo "$loaded_fingerprints" | grep -qF "$fingerprint"; then
        continue
      fi
      ssh-add "$key"
    done
fi

{{ end -}}
