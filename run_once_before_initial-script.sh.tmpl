{{ if .isArch -}}
#!/bin/bash
set -euo pipefail

# A live ISO runs from a read-only squashfs with a small tmpfs overlay. A full -Syu
# would replace systemd and the kernel underneath the running session, and the
# package install afterwards would exhaust the overlay -- both hang or kill the
# session. Fail fast with an explanation instead.
if [ -d /run/archiso ]; then
    echo "ERROR: this is an Arch live ISO (/run/archiso exists)." >&2
    echo "Install CachyOS to disk and boot the installed system before applying." >&2
    exit 1
fi

# Arch does not support partial upgrades: refresh and upgrade fully before
# installing anything, otherwise later -S calls can pull mismatched deps.
sudo pacman -Syu --noconfirm

# Toolchain needed to build AUR packages and to run the rest of this repo.
# ksshaskpass is here rather than only in the host package list because ssh has no
# way to ask for a passphrase without it whenever git is driven by another process.
sudo pacman -S --needed --noconfirm base-devel git zsh openssh age ksshaskpass

# CachyOS ships paru preinstalled, but a plain Arch or minimal VM image will not.
# CachyOS also carries it in its own repos, where it is rebuilt whenever pacman
# bumps the libalpm soname, so prefer that and only build as a fallback.
#
# The -bin package is deliberately not used. It ships a binary linked against
# whatever libalpm existed when its release was cut, so on a host whose pacman has
# moved on it dies with "libalpm.so.N: cannot open shared object file" every time
# it runs -- and its `libalpm.so>=14` dependency does not catch that, because
# pacman satisfies the version while providing a different soname. Building from
# source links against the libalpm actually installed here.
if ! command -v {{ .aurHelper }} &> /dev/null; then
    if ! sudo pacman -S --needed --noconfirm {{ .aurHelper }}; then
        build_dir="$(mktemp -d)"
        git clone --depth 1 "https://aur.archlinux.org/{{ .aurHelper }}.git" "${build_dir}/{{ .aurHelper }}"
        (cd "${build_dir}/{{ .aurHelper }}" && makepkg -si --noconfirm)
        rm -rf "${build_dir}"
    fi
fi

# Make zsh the login shell (chsh prompts for the account password).
zsh_path="$(command -v zsh)"
if [ "$(getent passwd "$USER" | cut -d: -f7)" != "${zsh_path}" ]; then
    echo "Setting ${zsh_path} as the login shell for ${USER}"
    chsh -s "${zsh_path}" "$USER"
fi

{{ else if eq .chezmoi.os "darwin" -}}
#!/bin/bash

# Install Homebrew
if [[ ! -d /opt/homebrew/ ]]
then
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

{{ end -}}
