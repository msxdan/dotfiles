{{/*
   Machine identity.

   Everything downstream (templates, .chezmoiignore, run_ scripts) branches on the
   derived facts below rather than on raw hostnames, so adding a new machine means
   adding one branch here instead of grepping the whole repo.

   NOTE: .chezmoidata/ is NOT available in this file -- the config is rendered before
   the source state is loaded -- which is why the host table is inline.
*/}}
{{- $os := .chezmoi.os -}}
{{- $hostname := .chezmoi.hostname -}}
{{- $osID := $os -}}
{{- $idLike := "" -}}
{{- if and (eq $os "linux") (hasKey .chezmoi "osRelease") -}}
{{-   $osID = index .chezmoi.osRelease "id" | default $os -}}
{{-   $idLike = index .chezmoi.osRelease "idLike" | default "" -}}
{{- end -}}
{{- $isArch := and (eq $os "linux") (or (eq $osID "arch") (contains "arch" $idLike) (ne (lookPath "pacman") "")) -}}

{{/*
   Detect the session from what is installed rather than from the hostname. A
   hostname is the wrong signal: it varies per machine and differs in case (a
   CachyOS live ISO reports "CachyOS", an installed box "cachyos"), and a mismatch
   silently demotes a workstation to a headless server.
*/}}
{{- $isDesktop := false -}}
{{- $desktopEnv := "" -}}
{{- $role := "server" -}}
{{- if eq $os "darwin" -}}
{{-   $isDesktop = true -}}
{{-   $desktopEnv = "aqua" -}}
{{-   $role = "workstation" -}}
{{- else if ne (lookPath "plasmashell") "" -}}
{{-   $isDesktop = true -}}
{{-   $desktopEnv = "kde" -}}
{{-   $role = "workstation" -}}
{{- else if ne (lookPath "gnome-shell") "" -}}
{{-   $isDesktop = true -}}
{{-   $desktopEnv = "gnome" -}}
{{-   $role = "workstation" -}}
{{- else -}}
{{-   $role = promptStringOnce . "role" "Role for this machine (workstation/server)" "server" -}}
{{-   $isDesktop = promptBoolOnce . "isDesktop" "Is this a graphical desktop machine?" (eq $role "workstation") -}}
{{-   if $isDesktop -}}
{{-     $desktopEnv = promptStringOnce . "desktopEnv" "Desktop environment (kde/gnome/other)" "kde" -}}
{{-   end -}}
{{- end -}}

{{/*
   Profiles decide which *identities* a machine serves, and gate the files that only
   make sense for one of them: the ec Postgres credentials, Databricks, the mm SSH
   block and context switch.

   Profiles are named after the identity rather than "work" so a second client can
   be added as another profile instead of overloading one flag. Templates test
   `has "ec" .profiles` directly, so no derived boolean has to be added each time.

   The default preserves what each machine already had, so re-initialising an
   existing host does not silently drop files it depends on: the Mac keeps ec, the
   personal CachyOS box does not get it.

   Defaults have to be computed here rather than read from .chezmoidata, because
   .chezmoidata is not available while the config template is rendered.
*/}}
{{- $defaultProfiles := list "personal" -}}
{{- if eq $os "darwin" -}}
{{-   $defaultProfiles = list "personal" "ec" -}}
{{- end -}}
{{- $profiles := promptMultichoiceOnce . "profiles" "Which profiles does this machine serve?" (list "personal" "ec") $defaultProfiles -}}
{{- $isEc := has "ec" $profiles -}}
{{- $isPersonal := has "personal" $profiles -}}

{{/*
   Clusters follow from the profiles, but stay overridable: the chosen profiles
   pre-select the obvious set and anything else can still be ticked on.
*/}}
{{- $defaultClusters := list -}}
{{- if $isPersonal }}{{ $defaultClusters = append $defaultClusters "homelab" }}{{ end -}}
{{- if $isEc }}{{ $defaultClusters = concat $defaultClusters (list "ec" "mm") }}{{ end -}}
encryption = "age"

[age]
   identity = "~/.config/chezmoi/.key"
   recipient = "age1yrzw5yfrhxpc0tajytcxgfc6rg8jpzue4qcvt0kr300qpx653ghsn7nhlg"

[data]
   hostname = {{ $hostname | quote }}
   role = {{ $role | quote }}
   osID = {{ $osID | quote }}
   isArch = {{ $isArch }}
   isDesktop = {{ $isDesktop }}
   desktopEnv = {{ $desktopEnv | quote }}
   isKDE = {{ eq $desktopEnv "kde" }}
   aurHelper = "paru"
   profiles = {{ $profiles | toToml }}
   kubeClusters = {{ promptMultichoiceOnce . "kubeClusters" "Which k8s clusters do you want configured?" (list "homelab" "ec" "mm") $defaultClusters | toToml }}
