{{/* Cross-platform ~/.zshenv content. Runs for every zsh invocation. */}}
# Export pipx binary directory
export PATH="$PATH:{{ .chezmoi.homeDir }}/.local/bin"

# chezmoi
export PATH="$PATH:$HOME/bin"

export TENV_AUTO_INSTALL=true
# Use terraform as default for terragrunt
export TERRAGRUNT_TFPATH="terraform"

export TF_CLI_ARGS_apply="-parallelism=40"
export TF_CLI_ARGS_plan="-parallelism=40"
export TF_CLI_CONFIG_FILE="{{ .chezmoi.homeDir }}/.terraformrc"

# Create kubeconfig symlink for existing kubeconfigs in ~/.private/.kube/config.d
if [[ -d ~/.private/.kube/config.d ]]; then
  mkdir -p ~/.kube/config.d
  # (N) is zsh's null_glob qualifier: without it an empty or missing directory
  # aborts the loop with "no matches found" instead of iterating zero times.
  for private_kube_config in ~/.private/.kube/config.d/*(N); do
    KUBE_FILE="$HOME/.kube/config.d/$(basename $private_kube_config)"
    if [ ! -L ${KUBE_FILE} ]; then
      ln -s $private_kube_config ${KUBE_FILE}
    fi
  done
fi

KUBECONFIG=${HOME}/.kube/config
if [[ -d ~/.kube/config.d ]]; then
  for kubeconfig in ~/.kube/config.d/*(N); do
    KUBECONFIG=${KUBECONFIG}:$kubeconfig
  done
fi
export KUBECONFIG
export K9S_CONFIG_DIR="{{ .chezmoi.homeDir }}/.config/k9s/"

export HELM_REGISTRY_CONFIG="${HOME}/.docker/config.json"

if [[ -d ~/.private/.env.d ]]; then
  for env in ~/.private/.env.d/*(N); do
    source $env
  done
fi

if [[ -r ~/.aliasrc ]]; then
  . ~/.aliasrc
fi

# Blog content provider
export BLOG_PROVIDER=local

# Required by k9s and probably other tools
export EDITOR='nvim'

export INFRACOST_CURRENCY='EUR'
