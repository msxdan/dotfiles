{{/* macOS-only ~/.zshrc additions, inserted between the two shared halves. */}}

# gcloud ships inside the Homebrew prefix on macOS
if [[ -f "$(brew --prefix)/share/google-cloud-sdk/path.zsh.inc" ]]; then
  source "$(brew --prefix)/share/google-cloud-sdk/path.zsh.inc"
  # source "$(brew --prefix)/share/google-cloud-sdk/completion.zsh.inc"
fi

#source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh
#source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# OrbStack. Make sure you execute this *after* asdf or other version managers are loaded
if (( $+commands[orbctl] )); then
  eval "$(orbctl completion zsh)"
  compdef _orb orbctl
  compdef _orb orb
fi
