{{/* Linux-only ~/.zshenv additions. */}}

# There is no Keychain on Linux; keys live in a user-scoped ssh-agent started by
# ~/.config/systemd/user/ssh-agent.service, which pins the socket to a fixed path.
if [[ -z ${SSH_AUTH_SOCK:-} && -n ${XDG_RUNTIME_DIR:-} ]]; then
  export SSH_AUTH_SOCK="${XDG_RUNTIME_DIR}/ssh-agent.socket"
fi

# Passphrase prompter for when ssh has no controlling terminal -- which is the case
# whenever git is driven by another process (chezmoi, an IDE, a systemd unit).
# Without one, ssh dies with "ssh_askpass: exec(...): No such file or directory".
# ksshaskpass stores the passphrase in KWallet, so it is asked for once, not per use.
#
# SSH_ASKPASS_REQUIRE is deliberately left unset: ssh then prompts on the terminal
# when there is one and only falls back to the dialog when there isn't.
if [[ -z ${SSH_ASKPASS:-} ]]; then
  for askpass in /usr/bin/ksshaskpass /usr/lib/ssh/ssh-askpass; do
    if [[ -x $askpass ]]; then
      export SSH_ASKPASS="$askpass"
      break
    fi
  done
fi
