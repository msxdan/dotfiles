{{ if .isArch -}}
{{- /*
     Machines do not share packages: look this host up in .chezmoidata/hosts.yaml by
     lowercased hostname and install only what it asks for. An unlisted host falls
     back to "default", and the script prints which key it matched so a hostname
     typo is obvious instead of silently installing the wrong set.
*/ -}}
{{- $hn := lower .chezmoi.hostname -}}
{{- $hostKey := "default" -}}
{{- if hasKey .hosts $hn }}{{ $hostKey = $hn }}{{ end -}}
{{- $host := index .hosts $hostKey -}}
#!/usr/bin/env bash
set -euo pipefail

# Lists are rendered inline from .chezmoidata/hosts.yaml, so editing them
# re-triggers this script automatically.
# arch-packages.sh" hash: {{ include ".scripts/lib/arch-packages.sh" | sha256sum }}
source {{ joinPath .chezmoi.sourceDir ".scripts/lib/arch-packages.sh" | quote }}

export AUR_HELPER={{ .aurHelper | quote }}

echo "Host '{{ .chezmoi.hostname }}' -> using the '{{ $hostKey }}' package list"
{{ if ne $hostKey $hn }}
echo "NOTE: '{{ $hn }}' is not listed in .chezmoidata/hosts.yaml; add it there"
echo "      if this machine should have its own package set."
{{ end }}
pkg::sync

pacman_packages=(
{{- range index $host "pacman" }}
  {{ . | quote }}
{{- end }}
)
pkg::pacman "${pacman_packages[@]}"

aur_packages=(
{{- range index $host "aur" }}
  {{ . | quote }}
{{- end }}
)
pkg::aur "${aur_packages[@]}"

pipx_packages=(
{{- range index $host "pipx" }}
  {{ . | quote }}
{{- end }}
)
pkg::pipx "${pipx_packages[@]}"

mise_tools=(
{{- range index $host "mise" }}
  {{ . | quote }}
{{- end }}
)
pkg::mise "${mise_tools[@]}"

vscode_extensions=(
{{- range index $host "vscode" }}
  {{ . | quote }}
{{- end }}
)
pkg::vscode "${vscode_extensions[@]}"

{{ range index $host "tenv" }}
pkg::tenv {{ (splitList "@" .) | first | quote }} {{ (splitList "@" .) | last | quote }}
{{- end }}

services=(
{{- range index $host "services" }}
  {{ . | quote }}
{{- end }}
)
for unit in "${services[@]}"; do
  pkg::enable_service "$unit"
done

user_services=(
{{- range index $host "user_services" }}
  {{ . | quote }}
{{- end }}
)
for unit in "${user_services[@]}"; do
  pkg::enable_user_service "$unit"
done

groups=(
{{- range index $host "groups" }}
  {{ . | quote }}
{{- end }}
)
for group in "${groups[@]}"; do
  pkg::add_user_to_group "$group"
done

pkg::report

{{ else if eq .chezmoi.os "darwin" -}}

#!/bin/bash

if [ ! -f ~/.docker/cli-plugins/docker-scout ]; then
  curl -sSfL https://raw.githubusercontent.com/docker/scout-cli/main/install.sh | sh -s --
fi

pipx install --include-deps ansible==10.7.0

pipx install shcheck # check http headers
pipx install keepercommander
pipx install molecule
pipx inject molecule "molecule-plugins"

tenv tf install --arch=amd64 1.13.1
tenv tg install 0.66.7
tenv tofu install --arch=amd64 1.10.6
#vagrant plugin install vagrant-vmware-desktop

goenv install 1.24.4
goenv global 1.24.4

volta install node@20
volta install pnpm@8.6.2
volta install yarn

# OPEN CODE
curl -fsSL https://opencode.ai/install | bash

# Agent OS
curl -sSL https://raw.githubusercontent.com/buildermethods/agent-os/main/scripts/base-install.sh | bash

# Reversing tools
pipx install apkid

{{ end -}}
