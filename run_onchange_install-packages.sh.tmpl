{{ else if .isArch -}}
#!/usr/bin/env bash
set -euo pipefail

# Package lists live in .chezmoidata/packages.yaml and are rendered inline below, so
# editing them re-triggers this script automatically.
# arch-packages.sh" hash: {{ include ".scripts/lib/arch-packages.sh" | sha256sum }}
source {{ joinPath .chezmoi.sourceDir ".scripts/lib/arch-packages.sh" | quote }}

export AUR_HELPER={{ .aurHelper | quote }}

pkg::sync

pacman_base=(
{{- range .packages.arch.pacman.base }}
  {{ . | quote }}
{{- end }}
)
pkg::pacman "${pacman_base[@]}"

aur_base=(
{{- range .packages.arch.aur.base }}
  {{ . | quote }}
{{- end }}
)
pkg::aur "${aur_base[@]}"
{{ if .isDesktop }}
pacman_desktop=(
{{- range .packages.arch.pacman.desktop }}
  {{ . | quote }}
{{- end }}
)
pkg::pacman "${pacman_desktop[@]}"

aur_desktop=(
{{- range .packages.arch.aur.desktop }}
  {{ . | quote }}
{{- end }}
)
pkg::aur "${aur_desktop[@]}"
{{ end }}
pipx_packages=(
{{- range .packages.arch.pipx }}
  {{ . | quote }}
{{- end }}
)
pkg::pipx "${pipx_packages[@]}"

mise_tools=(
{{- range .packages.mise }}
  {{ . | quote }}
{{- end }}
)
pkg::mise "${mise_tools[@]}"

pkg::tenv tf {{ .packages.tenv.tf | quote }}
pkg::tenv tg {{ .packages.tenv.tg | quote }}
pkg::tenv tofu {{ .packages.tenv.tofu | quote }}

# Docker needs its daemon running and the user in the docker group to be usable
# without sudo -- the macOS setup gets this from OrbStack instead.
pkg::enable_service docker.service
pkg::enable_service containerd.service
pkg::add_user_to_group docker

# Keep ssh keys in a user-scoped agent (see dot_config/systemd/user/ssh-agent.service).
systemctl --user enable --now ssh-agent.service || true

pkg::report

{{ else if eq .chezmoi.os "darwin" -}}

#!/bin/bash

if [ ! -f ~/.docker/cli-plugins/docker-scout ]; then
  curl -sSfL https://raw.githubusercontent.com/docker/scout-cli/main/install.sh | sh -s --
fi

pipx install --include-deps ansible==10.7.0

pipx install shcheck # check http headers
pipx install keepercommander
pipx install molecule
pipx inject molecule "molecule-plugins"

tenv tf install --arch=amd64 1.13.1
tenv tg install 0.66.7
tenv tofu install --arch=amd64 1.10.6
#vagrant plugin install vagrant-vmware-desktop

goenv install 1.24.4
goenv global 1.24.4

volta install node@20
volta install pnpm@8.6.2
volta install yarn

# OPEN CODE
curl -fsSL https://opencode.ai/install | bash

# Agent OS
curl -sSL https://raw.githubusercontent.com/buildermethods/agent-os/main/scripts/base-install.sh | bash

# Reversing tools
pipx install apkid

